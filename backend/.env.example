# Supabase project (publishable key: read-only for anon through RLS)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="sb_publishable_<your-publishable-key>"
# Admin connection: ONLY for migrations, seeding and creating the API role (npm run db:*, scripts/create_api_roles.py)
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres"
# Read-only role used by the FastAPI server (written by scripts/create_api_roles.py)
API_DATABASE_URL="postgresql://flownetic_api_ro.<project-ref>:<password>@<pooler-host>:5432/postgres"
# Write role used ONLY by the import endpoints (written by scripts/create_api_roles.py)
API_WRITE_DATABASE_URL="postgresql://flownetic_api_rw.<project-ref>:<password>@<pooler-host>:5432/postgres"
# Optional: CORS_ORIGINS='["http://localhost:5173"]'  APP_PROFILE=demo
# Gemini API key for live AI investigations (backend only; never exposed to the browser). Leave empty for mock mode.
GEMINI_API_KEY=""
# Optional: GEMINI_MODEL="gemini-2.5-flash"
